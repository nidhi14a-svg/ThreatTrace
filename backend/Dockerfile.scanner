# Dedicated Thread Trace Scanner Worker Container
# Runs static analysis tools (Semgrep, Bandit, Gitleaks, OSV-Scanner, Custom Rules)
# Non-root user (UID 10001), air-gapped network, read-only rootfs compatible

FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    HOME=/tmp \
    TMPDIR=/tmp \
    PYTHONPATH=/app \
    SEMGREP_SEND_METRICS=off \
    SEMGREP_SETTINGS_CACHE_DISABLED=1 \
    SEMGREP_RULES=/app/rules/owasp-top-ten.yml \
    OSV_SCANNER_OFFLINE=true \
    OSV_SCANNER_LOCAL_DB_CACHE_DIRECTORY=/app/osv-db \
    XDG_CACHE_HOME=/app/osv-db

WORKDIR /app

# 1. Install runtime system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
 && rm -rf /var/lib/apt/lists/*

# 2. Install pinned static binaries for Gitleaks and OSV-Scanner
# Gitleaks v8.21.2
RUN curl -sSL "https://github.com/gitleaks/gitleaks/releases/download/v8.21.2/gitleaks_8.21.2_linux_x64.tar.gz" \
    | tar -xz -C /usr/local/bin gitleaks \
 && chmod 755 /usr/local/bin/gitleaks

# OSV-Scanner v1.9.0
RUN curl -sSL -o /usr/local/bin/osv-scanner-bin "https://github.com/google/osv-scanner/releases/download/v1.9.0/osv-scanner_linux_amd64" \
 && chmod 755 /usr/local/bin/osv-scanner-bin

# OSV-Scanner wrapper to normalize CLI flags between interface and v1.9.0
RUN printf '#!/bin/sh\n\
ARGS=""\n\
DIR_ARGS=""\n\
HAS_SCAN=0\n\
HAS_OFFLINE=0\n\
\n\
if [ "$1" = "--help" ] || [ "$1" = "-h" ] || [ "$1" = "--version" ] || [ "$1" = "-v" ]; then\n\
    exec /usr/local/bin/osv-scanner-bin "$@"\n\
fi\n\
\n\
for arg in "$@"; do\n\
    if [ "$arg" = "scan" ]; then\n\
        HAS_SCAN=1\n\
        break\n\
    fi\n\
done\n\
\n\
if [ "$HAS_SCAN" -eq 0 ]; then\n\
    ARGS="scan"\n\
fi\n\
\n\
while [ "$#" -gt 0 ]; do\n\
    case "$1" in\n\
        --offline|--offline-vulnerabilities|--experimental-offline)\n\
            if [ "$HAS_OFFLINE" -eq 0 ]; then\n\
                ARGS="$ARGS --experimental-offline"\n\
                HAS_OFFLINE=1\n\
            fi\n\
            shift\n\
            ;;\n\
        --local-db-path)\n\
            export OSV_SCANNER_LOCAL_DB_CACHE_DIRECTORY="$2"\n\
            export XDG_CACHE_HOME="$2"\n\
            shift 2\n\
            ;;\n\
        --json)\n\
            ARGS="$ARGS --format json"\n\
            shift\n\
            ;;\n\
        -f|--format|-D|--docker|-L|--lockfile|-S|--sbom|--config|--output|--verbosity|--call-analysis|--no-call-analysis|--experimental-licenses)\n\
            ARGS="$ARGS $1 $2"\n\
            shift 2\n\
            ;;\n\
        -r|--recursive)\n\
            ARGS="$ARGS $1"\n\
            shift\n\
            ;;\n\
        -*)\n\
            ARGS="$ARGS $1"\n\
            shift\n\
            ;;\n\
        *)\n\
            if [ "$1" != "scan" ]; then\n\
                DIR_ARGS="$DIR_ARGS $1"\n\
            fi\n\
            shift\n\
            ;;\n\
    esac\n\
done\n\
\n\
exec /usr/local/bin/osv-scanner-bin $ARGS $DIR_ARGS\n' > /usr/local/bin/osv-scanner \
 && chmod 755 /usr/local/bin/osv-scanner

# 3. Create unprivileged non-root scanner user and group (UID 10001)
RUN groupadd -g 10001 scanner \
 && useradd -u 10001 -g 10001 -m -s /sbin/nologin -d /home/scanner scanner

# 4. Pre-download offline databases and rulesets
# Semgrep OWASP Top 10 rulepack
RUN mkdir -p /app/rules && \
    curl -sSL "https://semgrep.dev/c/p/owasp-top-ten" -o /app/rules/owasp-top-ten.yml && \
    chmod -R 755 /app/rules

# OSV PyPI vulnerability database
RUN mkdir -p /app/osv-db/osv-offline/PyPI /app/osv-db/osv-scanner/PyPI /app/osv-db/PyPI && \
    curl -sSL "https://osv-vulnerabilities.storage.googleapis.com/PyPI/all.zip" -o /app/osv-db/all.zip && \
    cp /app/osv-db/all.zip /app/osv-db/osv-offline/PyPI/all.zip && \
    cp /app/osv-db/all.zip /app/osv-db/osv-scanner/PyPI/all.zip && \
    cp /app/osv-db/all.zip /app/osv-db/PyPI/all.zip && \
    chmod -R 755 /app/osv-db

# 5. Install Python dependencies (Semgrep, Bandit, Pydantic, AnyIO)
COPY requirements-scanner.txt .
RUN pip install --no-cache-dir -r requirements-scanner.txt

# 6. Copy backend application scanner packages
COPY app /app/app

# 7. Apply directory permissions and create mount points
RUN chmod -R 755 /app \
 && mkdir -p /tmp/thread-trace/workspaces \
 && chmod -R 777 /tmp/thread-trace \
 && chmod 1777 /tmp

USER 10001:10001
WORKDIR /tmp

ENTRYPOINT ["python", "-m", "app.scanners.worker_runner"]
CMD ["--help"]
